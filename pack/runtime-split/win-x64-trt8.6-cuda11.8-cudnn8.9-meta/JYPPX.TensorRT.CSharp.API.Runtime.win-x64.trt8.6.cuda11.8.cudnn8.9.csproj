<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt8.6.cuda11.8.cudnn8.9</PackageId>
    <Title>JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt8.6.cuda11.8.cudnn8.9</Title>
    <Description>Split runtime collection package for TensorRT 8.6 + CUDA 11.8 + cuDNN 8.9 on Windows x64.</Description>
    <JYPPXRuntimeKey>win-x64-trt8.6-cuda11.8-cudnn8.9-meta</JYPPXRuntimeKey>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <PackageTags>TensorRT;CUDA;runtime;split-delivery;collection;meta</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt8.6.cuda11.8.cudnn8.9.Bridge" Version="$(JYPPXBridgePackageVersion)" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt8.6.cuda11.8.cudnn8.9.CudaCudnn" Version="$(JYPPXCudaCudnnPackageVersion)" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt8.6.cuda11.8.cudnn8.9.TensorRtRuntime" Version="$(JYPPXTensorRtPackageVersion)" />
  </ItemGroup>
</Project>
