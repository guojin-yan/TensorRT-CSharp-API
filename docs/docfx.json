{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/JYPPX.Shared/**/*.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    },
    {
      "src": [
        {
          "files": [
            "src/JYPPX.TensorRtSharp/**/*.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    },
    {
      "src": [
        {
          "files": [
            "src/JYPPX.CudaSharp/**/*.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "releases/**/*.md",
          "articles/**/*.md"
        ]
      },
      {
        "files": [
          "api/**.yml"
        ]
      }
    ],
      "resource": [
        {
          "files": [
            "images/**",
            "articles/zh-cn/article-index.json",
            "articles/zh-cn/04-api/api-runtime-evidence-20260813.json",
            "articles/zh-cn/03-applications/onnxtoengine/onnxtoengine-runtime-evidence-20260813.json"
          ]
        }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "TensorRT CSharp API v4.0",
      "_disableNextArticle": true,
      "_enableSearch": true
    }
  }
}
