<Project>
  <PropertyGroup>
    <!--
      Keep the public-package dependency in one place. Samples consume the exact
      4.0.0 stable release so local and CI restores resolve the same API surface.
      Update this one property when the maintained stable release advances.
    -->
    <JYPPXTensorRtSamplePackageVersion Condition="'$(JYPPXTensorRtSamplePackageVersion)' == ''">4.0.0</JYPPXTensorRtSamplePackageVersion>
    <DefineConstants>$(DefineConstants);JYPPX_PUBLIC_STABLE_4_0_0</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JYPPX.TensorRT.CSharp.API"
                      Version="$(JYPPXTensorRtSamplePackageVersion)" />
  </ItemGroup>
</Project>
