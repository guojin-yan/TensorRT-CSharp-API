<Project>
  <PropertyGroup>
    <!--
      Keep the public-package dependency in one place. The 4.0.0-* floating rule
      follows the current 4-series preview line while excluding historical 4.x
      packages that use a different API surface. Update this one property when
      the maintained 4-series release line advances.
    -->
    <JYPPXTensorRtSamplePackageVersion Condition="'$(JYPPXTensorRtSamplePackageVersion)' == ''">4.0.0-*</JYPPXTensorRtSamplePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JYPPX.TensorRT.CSharp.API"
                      Version="$(JYPPXTensorRtSamplePackageVersion)" />
  </ItemGroup>
</Project>
