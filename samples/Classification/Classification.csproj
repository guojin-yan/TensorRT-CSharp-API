<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Classification</AssemblyName>
    <RootNamespace>ClassificationSample</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <JYPPXIncludeTensorRtOnnxSampleSupport>true</JYPPXIncludeTensorRtOnnxSampleSupport>
    <VersionPrefix>4.0.0</VersionPrefix>
    <Version Condition="'$(JYPPXPackageVersion)' != ''">$(JYPPXPackageVersion)</Version>
    <Authors>JYPPX</Authors>
    <Company>JYPPX</Company>
    <RepositoryUrl>https://github.com/guojin-yan/TensorRT-CSharp-API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>JYPPX.TensorRT.CSharp.API.Classification</PackageId>
    <Title>JYPPX TensorRT C# API Classification</Title>
    <Description>Reusable image preprocessing, classification output validation, visualization, and command runner for TensorRtSharp4.0.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageTags>TensorRT;CUDA;classification;ResNet;computer-vision</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JYPPX.TensorRtSharp\JYPPX.TensorRtSharp.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
