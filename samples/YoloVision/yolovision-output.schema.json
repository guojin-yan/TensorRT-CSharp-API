{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jyppx.github.io/TensorRtSharp/schemas/yolovision-output.schema.json",
  "title": "YoloVision output schema",
  "description": "Machine-readable schema for YoloVision detection, segmentation, pose, OBB, classification, and semantic output records. This schema is diagnostic/adoption infrastructure and is not runtime proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "modelFamily",
    "input",
    "engine",
    "runtime",
    "outputs",
    "postprocess",
    "predictions",
    "boundary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "yolovision-output.v1"
    },
    "task": {
      "type": "string",
      "enum": [
        "det",
        "cls",
        "seg",
        "obb",
        "pose",
        "sem"
      ]
    },
    "modelFamily": {
      "type": "string",
      "enum": [
        "yolov5",
        "yolov6",
        "yolov7",
        "yolov8",
        "yolov9",
        "yolov10",
        "yolov11",
        "yolov26",
        "yolox",
        "custom"
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        },
        "classCount": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "external-tensor",
            "synthetic-pattern",
            "preprocessed-image-tensor"
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^$|^[a-fA-F0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "preprocessedTensor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^$|^[a-fA-F0-9]{64}$"
            },
            "elementCount": {
              "type": "integer",
              "minimum": 1
            },
            "layout": {
              "type": "string",
              "enum": [
                "NCHW",
                "NHWC"
              ]
            },
            "colorOrder": {
              "type": "string",
              "enum": [
                "RGB",
                "BGR"
              ]
            },
            "normalized": {
              "type": "boolean"
            },
            "scale": {
              "type": "number"
            }
          }
        },
        "letterbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resizeMode": {
              "type": "string",
              "enum": [
                "letterbox",
                "stretch",
                "shorter-side-center-crop"
              ]
            },
            "alignment": {
              "type": "string",
              "enum": [
                "center",
                "top-left"
              ]
            },
            "targetWidth": {
              "type": "integer",
              "minimum": 1
            },
            "targetHeight": {
              "type": "integer",
              "minimum": 1
            },
            "resizedWidth": {
              "type": "integer",
              "minimum": 1
            },
            "resizedHeight": {
              "type": "integer",
              "minimum": 1
            },
            "padX": {
              "type": "integer",
              "minimum": 0
            },
            "padY": {
              "type": "integer",
              "minimum": 0
            },
            "scaleX": {
              "type": "number"
            },
            "scaleY": {
              "type": "number"
            },
            "fillValue": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "centerCropEnabled": {
              "type": "boolean"
            },
            "resizeShorterSide": {
              "type": "integer",
              "minimum": 0
            },
            "cropX": {
              "type": "integer",
              "minimum": 0
            },
            "cropY": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "inputTensors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tensorName", "shape", "elementCount", "byteLength", "sha256", "sourceClassification", "sourcePath", "preview"],
        "properties": {
          "tensorName": { "type": "string", "minLength": 1 },
          "shape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "elementCount": { "type": "integer", "minimum": 1 },
          "byteLength": { "type": "integer", "minimum": 4 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceClassification": { "type": "string", "enum": ["float-data-file", "raw-byte-file", "deterministic-pattern"] },
          "sourcePath": { "type": "string" },
          "preview": { "type": "array", "maxItems": 8, "items": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["NaN", "Infinity", "-Infinity"] }] } }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "inputShape"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        },
        "inputShape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "precision": {
          "type": "string",
          "enum": [
            "fp32",
            "fp16",
            "int8",
            "mixed",
            "unknown"
          ]
        },
        "materialization": {
          "type": "string",
          "enum": [
            "in-memory-from-onnx",
            "engine-file"
          ]
        },
        "modelPath": {
          "type": "string"
        },
        "modelSha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        },
        "engineDeviceMemoryBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "os",
        "rid",
        "cudaVersion",
        "tensorRtVersion",
        "runtimePackageId"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "rid": {
          "type": "string"
        },
        "cudaVersion": {
          "type": "string"
        },
        "tensorRtVersion": {
          "type": "string"
        },
        "runtimePackageId": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "role",
          "shape"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "boxes",
              "scores",
            "classes",
            "logits",
            "probabilities",
            "raw-scores",
            "masks",
            "maskCoefficients",
            "prototypes",
            "keypoints",
              "obb",
              "semantic",
              "endToEnd",
              "unknown"
            ]
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "valueSha256": {
            "type": "string",
            "pattern": "^$|^[a-fA-F0-9]{64}$"
          },
          "valuePreview": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "referenceValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "completed", "passed", "absoluteTolerance", "relativeTolerance", "nanPolicy", "infinityPolicy", "tensorComparisons", "diagnostics", "proofBoundary"],
      "properties": {
        "requested": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "absoluteTolerance": { "type": "number", "minimum": 0 },
        "relativeTolerance": { "type": "number", "minimum": 0 },
        "nanPolicy": { "type": "string", "enum": ["reject", "equal"] },
        "infinityPolicy": { "type": "string", "enum": ["exact", "reject"] },
        "tensorComparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tensorName", "referencePath", "referenceSha256", "sourceClassification", "actualShape", "referenceShape", "actualElementCount", "referenceElementCount", "comparedElementCount", "mismatchCount", "firstMismatchIndex", "maximumAbsoluteError", "maximumRelativeError", "completed", "passed", "diagnostic"],
            "properties": {
              "tensorName": { "type": "string", "minLength": 1 },
              "referencePath": { "type": "string", "minLength": 1 },
              "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "sourceClassification": { "type": "string", "minLength": 1 },
              "actualShape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
              "referenceShape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
              "actualElementCount": { "type": "integer", "minimum": 1 },
              "referenceElementCount": { "type": "integer", "minimum": 0 },
              "comparedElementCount": { "type": "integer", "minimum": 0 },
              "mismatchCount": { "type": "integer", "minimum": 0 },
              "firstMismatchIndex": { "type": "integer", "minimum": -1 },
              "maximumAbsoluteError": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["NaN", "Infinity", "-Infinity"] }] },
              "maximumRelativeError": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["NaN", "Infinity", "-Infinity"] }] },
              "completed": { "type": "boolean" },
              "passed": { "type": "boolean" },
              "diagnostic": { "type": "string" }
            }
          }
        },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "proofBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "bindingMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineName",
        "profileIndex",
        "isReadyForEnqueue",
        "evidenceKind",
        "isRuntimeProof",
        "tensors"
      ],
      "properties": {
        "engineName": {
          "type": "string"
        },
        "profileIndex": {
          "type": "integer",
          "minimum": 0
        },
        "isReadyForEnqueue": {
          "type": "boolean"
        },
        "evidenceKind": {
          "type": "string",
          "const": "copied-pointer-free-TensorRtEngineBindingReport; not runtime proof"
        },
        "isRuntimeProof": {
          "type": "boolean",
          "const": false
        },
        "tensors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "name",
              "ioMode",
              "semanticRole",
              "dataType",
              "engineShape",
              "location",
              "isShapeInferenceIO",
              "bytesPerComponent",
              "componentsPerElement",
              "effectiveBytesPerComponent",
              "effectiveComponentsPerElement",
              "usesDataTypeSizeFallback",
              "format",
              "formatDescription",
              "vectorizedDimension",
              "profileIndex",
              "profileMinShape",
              "profileOptShape",
              "profileMaxShape",
              "valueCaptured",
              "diagnostics"
            ],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" },
              "ioMode": { "type": "string", "enum": ["Unknown", "Input", "Output"] },
              "semanticRole": { "type": "string" },
              "dataType": { "type": "string" },
              "engineShape": { "type": "array", "items": { "type": "integer" } },
              "location": { "type": "string", "enum": ["Device", "Host"] },
              "isShapeInferenceIO": { "type": "boolean" },
              "bytesPerComponent": { "type": "integer" },
              "componentsPerElement": { "type": "integer" },
              "effectiveBytesPerComponent": { "type": "integer", "minimum": 0 },
              "effectiveComponentsPerElement": { "type": "integer", "minimum": 0 },
              "usesDataTypeSizeFallback": { "type": "boolean" },
              "format": { "type": "string" },
              "formatDescription": { "type": "string" },
              "vectorizedDimension": { "type": "integer" },
              "profileIndex": { "type": "integer", "minimum": 0 },
              "profileMinShape": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "array", "items": { "type": "integer" } }
                ]
              },
              "profileOptShape": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "array", "items": { "type": "integer" } }
                ]
              },
              "profileMaxShape": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "array", "items": { "type": "integer" } }
                ]
              },
              "valueCaptured": { "type": "boolean" },
              "runtimeShape": { "type": "array", "items": { "type": "integer" } },
              "diagnostics": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "postprocess": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "confidenceThreshold",
        "nmsThreshold"
      ],
      "properties": {
        "confidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nmsThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maskThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classificationScoreMode": {
          "type": "string",
          "enum": ["raw", "logits", "probabilities"]
        },
        "classCount": {
          "type": "integer",
          "minimum": 0
        },
        "hasObjectness": {
          "type": ["boolean", "null"]
        },
        "coordinateSpace": {
          "type": "string",
          "const": "model-input-pixels"
        },
        "angleUnit": {
          "type": "string",
          "enum": [
            "degree",
            "radian",
            "normalized",
            "unknown"
          ]
        },
        "angleRange": {
          "type": "string"
        }
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/detectionPrediction"
          },
          {
            "$ref": "#/$defs/classificationPrediction"
          },
          {
            "$ref": "#/$defs/segmentationPrediction"
          },
          {
            "$ref": "#/$defs/posePrediction"
          },
          {
            "$ref": "#/$defs/obbPrediction"
          },
          {
            "$ref": "#/$defs/semanticPrediction"
          }
        ]
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRuntimeProof",
        "evidenceKind",
        "forbiddenSubstitutes"
      ],
      "properties": {
        "isRuntimeProof": {
          "type": "boolean",
          "const": false
        },
        "evidenceKind": {
          "type": "string",
          "const": "YoloVision output schema; readonly diagnostics; not runtime proof"
        },
        "forbiddenSubstitutes": {
          "type": "array",
          "contains": {
            "const": "build-only"
          },
          "items": {
            "type": "string",
            "enum": [
              "build-only",
              "dry-run",
              "template",
              "local feed",
              "ProjectReference",
              "direct `.nupkg`",
              "TensorRtExec report",
              "YoloVision matrix",
              "OnnxToEngine report",
              "readonly diagnostics"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "detectionPrediction": {
      "type": "object",
      "required": [
        "task",
        "box",
        "classId",
        "className",
        "score"
      ],
      "properties": {
        "task": {
          "const": "det"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "classId": {
          "type": "integer"
        },
        "className": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "classificationPrediction": {
      "type": "object",
      "required": [
        "task",
        "classId",
        "className",
        "score"
      ],
      "properties": {
        "task": {
          "const": "cls"
        },
        "classId": {
          "type": "integer"
        },
        "className": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "segmentationPrediction": {
      "type": "object",
      "required": [
        "task",
        "box",
        "classId",
        "className",
        "score",
        "maskShape",
        "maskPixelCount",
        "maskTotalPixelCount",
        "maskThreshold",
        "maskValueKind",
        "maskPixelCountScope"
      ],
      "properties": {
        "task": {
          "const": "seg"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "classId": {
          "type": "integer"
        },
        "className": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "maskShape": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "maskPixelCount": {
          "type": "integer"
        },
        "maskTotalPixelCount": {
          "type": "integer"
        },
        "maskThreshold": {
          "type": "number"
        },
        "maskValueKind": {
          "type": "string",
          "enum": ["probability", "raw-logits"]
        },
        "maskPixelCountScope": {
          "type": "string",
          "const": "prototype-grid-before-crop-resize"
        },
        "spatialTransform": {
          "$ref": "#/$defs/segmentationSpatialTransform"
        }
      }
    },
    "segmentationSpatialTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "coordinateSpace",
        "cropToDetection",
        "interpolation",
        "sourceWidth",
        "sourceHeight",
        "targetWidth",
        "targetHeight",
        "resizedWidth",
        "resizedHeight",
        "padX",
        "padY",
        "scaleX",
        "scaleY",
        "finalMaskShape",
        "finalMaskPixelCount",
        "finalMaskTotalPixelCount",
        "finalMaskThreshold",
        "finalMaskValueKind",
        "finalMaskScope",
        "sourceBox",
        "boundary"
      ],
      "properties": {
        "applied": {
          "type": "boolean",
          "const": true
        },
        "coordinateSpace": {
          "type": "string",
          "enum": ["model-input-pixels", "normalized"]
        },
        "cropToDetection": {
          "type": "boolean"
        },
        "interpolation": {
          "type": "string",
          "const": "bilinear"
        },
        "sourceWidth": {
          "type": "integer",
          "minimum": 1
        },
        "sourceHeight": {
          "type": "integer",
          "minimum": 1
        },
        "targetWidth": {
          "type": "integer",
          "minimum": 1
        },
        "targetHeight": {
          "type": "integer",
          "minimum": 1
        },
        "resizedWidth": {
          "type": "integer",
          "minimum": 1
        },
        "resizedHeight": {
          "type": "integer",
          "minimum": 1
        },
        "padX": {
          "type": "integer",
          "minimum": 0
        },
        "padY": {
          "type": "integer",
          "minimum": 0
        },
        "scaleX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaleY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "finalMaskShape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "finalMaskPixelCount": {
          "type": "integer",
          "minimum": 0
        },
        "finalMaskTotalPixelCount": {
          "type": "integer",
          "minimum": 1
        },
        "finalMaskThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "finalMaskValueKind": {
          "type": "string",
          "const": "probability"
        },
        "finalMaskScope": {
          "type": "string",
          "const": "source-image-after-explicit-preprocess-inverse-and-optional-box-crop"
        },
        "sourceBox": {
          "$ref": "#/$defs/box"
        },
        "boundary": {
          "type": "string",
          "const": "explicit-preprocess-metadata-transform; owner must validate exporter-specific mask alignment"
        }
      }
    },
    "posePrediction": {
      "type": "object",
      "required": [
        "task",
        "box",
        "score",
        "keypoints"
      ],
      "properties": {
        "task": {
          "const": "pose"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "score": {
          "type": "number"
        },
        "keypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "x",
              "y",
              "score"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "score": {
                "type": "number"
              },
              "visibility": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "obbPrediction": {
      "type": "object",
      "required": [
        "task",
        "center",
        "size",
        "angle",
        "angleUnit",
        "angleRange",
        "classId",
        "className",
        "score"
      ],
      "properties": {
        "task": {
          "const": "obb"
        },
        "center": {
