{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/TensorRT-CSharp-API/blob/TensorRtSharp4.0/samples/YoloVision/yolovision-semantic-map-artifacts.schema.json",
  "title": "YoloVision semantic map artifacts manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "classCount",
    "width",
    "height",
    "pixelCount",
    "dominantClassId",
    "dominantClassName",
    "classIndexArtifact",
    "classHistogram",
    "boundary"
  ],
  "properties": {
    "schemaVersion": { "const": "yolovision-semantic-map-artifacts.v1" },
    "task": { "const": "sem" },
    "classCount": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "pixelCount": { "type": "integer", "minimum": 1 },
    "dominantClassId": { "type": "integer", "minimum": 0 },
    "dominantClassName": { "type": "string" },
    "classIndexArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "path", "shape", "elementCount", "byteLength", "sha256", "dataType", "layout"],
      "properties": {
        "role": { "const": "semantic-class-index-map" },
        "fileName": { "type": "string" },
        "path": { "type": "string" },
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "elementCount": { "type": "integer", "minimum": 1 },
        "byteLength": { "type": "integer", "minimum": 4 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "dataType": { "const": "int32-little-endian" },
        "layout": { "const": "row-major-hw" }
      }
    },
    "classHistogram": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classId", "className", "pixelCount"],
        "properties": {
          "classId": { "type": "integer", "minimum": 0 },
          "className": { "type": "string" },
          "pixelCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isRuntimeProof", "isPackageConsumerProof", "isPostPublishProof", "evidenceKind"],
      "properties": {
        "isRuntimeProof": { "const": false },
        "isPackageConsumerProof": { "const": false },
        "isPostPublishProof": { "const": false },
        "evidenceKind": { "type": "string" }
      }
    }
  }
}
