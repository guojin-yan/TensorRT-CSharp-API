<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <RepositoryUrl>https://github.com/guojin-yan/TensorRT-CSharp-API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Company>JYPPX</Company>
    <Authors>JYPPX</Authors>
    <Product>TensorRtSharp4.0</Product>
    <VersionPrefix>4.0.0</VersionPrefix>
    <Version Condition="'$(JYPPXPackageVersion)' != ''">$(JYPPXPackageVersion)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <JYPPXSuppressMissingXmlDocs Condition="'$(JYPPXSuppressMissingXmlDocs)' == ''">true</JYPPXSuppressMissingXmlDocs>
    <NoWarn>$(NoWarn)$(JYPPXMissingXmlDocNoWarnSuffix)</NoWarn>
    <SupportedArchitecture>x64</SupportedArchitecture>
    <JYPPXBridgeLibraryName>jyppxtrtbridge</JYPPXBridgeLibraryName>
    <JYPPXManagedTargetFrameworks>net46;net461;net462;net47;net471;net472;net48;net481;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</JYPPXManagedTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <JYPPXMissingXmlDocNoWarnSuffix Condition="'$(JYPPXSuppressMissingXmlDocs)' == 'true'">;1591</JYPPXMissingXmlDocNoWarnSuffix>
    <JYPPXMissingXmlDocNoWarnSuffix Condition="'$(JYPPXSuppressMissingXmlDocs)' != 'true'"></JYPPXMissingXmlDocNoWarnSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != '' and $([System.String]::Copy('$(TargetFramework)').StartsWith('net4'))">
    <DefineConstants>$(DefineConstants);JYPPX_NETFRAMEWORK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and $([System.String]::Copy('$(TargetFramework)').StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
