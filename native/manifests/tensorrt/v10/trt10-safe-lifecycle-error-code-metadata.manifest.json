{
  "$schema": "../../bridge-api.schema.json",
  "module": "tensorrt",
  "versionLine": "10",
  "apis": [
    {
      "id": "trt10-builder-build-engine-with-config-owner-safe",
      "entryPoint": "jyppx_trt10_builder_build_engine_with_config",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-destroys",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "builder", "type": "JYPPX_TensorRtBuilder*", "direction": "in" },
        { "name": "network", "type": "JYPPX_TensorRtNetworkDefinition*", "direction": "in" },
        { "name": "config", "type": "JYPPX_TensorRtBuilderConfig*", "direction": "in" },
        { "name": "out_engine", "type": "JYPPX_TensorRtCudaEngine**", "direction": "out", "ownership": "caller-destroys" }
      ]
    },
    {
      "id": "trt10-error-code-enum-max-metadata",
      "entryPoint": "jyppx_trt10_error_code_get_exclusive_upper_bound",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "out_exclusive_upper_bound", "type": "int32_t*", "direction": "out" }
      ]
    }
  ]
}
