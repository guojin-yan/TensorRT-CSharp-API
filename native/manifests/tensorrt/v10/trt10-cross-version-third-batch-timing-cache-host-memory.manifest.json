      "entryPoint": "jyppx_trt10_timing_cache_query",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "cache", "type": "JYPPX_TensorRtTimingCache*", "direction": "in" },
        { "name": "key_data", "type": "const uint8_t*", "direction": "in", "managedType": "byte[]", "moduleManagedType": "byte[]" },
        { "name": "key_size", "type": "int32_t", "direction": "in" },
        { "name": "out_tactic_hash", "type": "uint64_t*", "direction": "out", "managedType": "out ulong", "moduleManagedType": "out ulong" },
        { "name": "out_timing_msec", "type": "float*", "direction": "out", "managedType": "out float", "moduleManagedType": "out float" },
        { "name": "out_found", "type": "JYPPX_Boolean*", "direction": "out" }
      ]
    },
    {
      "id": "jyppx-trt10-timing-cache-update",
      "entryPoint": "jyppx_trt10_timing_cache_update",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "cache", "type": "JYPPX_TensorRtTimingCache*", "direction": "in" },
        { "name": "key_data", "type": "const uint8_t*", "direction": "in", "managedType": "byte[]", "moduleManagedType": "byte[]" },
        { "name": "key_size", "type": "int32_t", "direction": "in" },
