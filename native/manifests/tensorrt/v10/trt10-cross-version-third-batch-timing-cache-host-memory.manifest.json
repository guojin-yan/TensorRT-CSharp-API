      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "cache", "type": "JYPPX_TensorRtTimingCache*", "direction": "in" },
        { "name": "input_cache", "type": "JYPPX_TensorRtTimingCache*", "direction": "in" },
        { "name": "ignore_mismatch", "type": "JYPPX_Boolean", "direction": "in" },
        { "name": "out_combined", "type": "JYPPX_Boolean*", "direction": "out" }
      ]
    },
    {
      "id": "jyppx-trt10-timing-cache-reset",
      "entryPoint": "jyppx_trt10_timing_cache_reset",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "cache", "type": "JYPPX_TensorRtTimingCache*", "direction": "in" },
        { "name": "out_reset", "type": "JYPPX_Boolean*", "direction": "out" }
      ]
    },
    {
      "id": "jyppx-trt10-timing-cache-query-key-count",
      "entryPoint": "jyppx_trt10_timing_cache_query_key_count",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "cache", "type": "JYPPX_TensorRtTimingCache*", "direction": "in" },
        { "name": "out_key_count", "type": "int64_t*", "direction": "out" }
      ]
    },
    {
