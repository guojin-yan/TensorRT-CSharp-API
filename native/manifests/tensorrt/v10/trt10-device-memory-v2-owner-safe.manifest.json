{
  "$schema": "../bridge-api.schema.json",
  "module": "tensorrt",
  "versionLine": "10",
  "apis": [
    {
      "id": "trt10-execution-context-set-device-memory-v2",
      "entryPoint": "jyppx_trt10_execution_context_set_device_memory_v2",
      "returnType": "BridgeStatusCode",
      "ownership": "context-borrows-memory-managed-lease",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10 && JYPPX_HAS_CUDA_TOOLKIT",
      "parameters": [
        { "name": "context", "type": "JYPPX_TensorRtExecutionContext*", "direction": "in" },
        { "name": "memory", "type": "JYPPX_CudaMemory*", "direction": "in" }
      ]
    },
    {
      "id": "trt10-execution-context-clear-device-memory-v2",
      "entryPoint": "jyppx_trt10_execution_context_clear_device_memory_v2",
      "returnType": "BridgeStatusCode",
      "ownership": "context-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 10",
      "parameters": [
        { "name": "context", "type": "JYPPX_TensorRtExecutionContext*", "direction": "in" }
      ]
    }
  ]
}
