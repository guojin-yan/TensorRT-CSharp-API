{
  "$schema": "../../bridge-api.schema.json",
  "module": "tensorrt",
  "versionLine": "8",
  "apis": [
    {
      "id": "trt8-builder-build-engine-with-config-owner-safe",
      "entryPoint": "jyppx_trt8_builder_build_engine_with_config",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-destroys",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "builder", "type": "JYPPX_TensorRtBuilder*", "direction": "in" },
        { "name": "network", "type": "JYPPX_TensorRtNetworkDefinition*", "direction": "in" },
        { "name": "config", "type": "JYPPX_TensorRtBuilderConfig*", "direction": "in" },
        { "name": "out_engine", "type": "JYPPX_TensorRtCudaEngine**", "direction": "out", "ownership": "caller-destroys" }
      ]
    },
    {
      "id": "trt8-builder-config-get-plugin-to-serialize-caller-buffer",
      "entryPoint": "jyppx_trt8_builder_config_get_plugin_to_serialize",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "config", "type": "JYPPX_TensorRtBuilderConfig*", "direction": "in" },
        { "name": "index", "type": "int32_t", "direction": "in" },
        { "name": "output_buffer", "type": "char*", "direction": "out", "managedType": "IntPtr", "moduleManagedType": "byte[]" },
        { "name": "output_buffer_size", "type": "size_t", "direction": "in", "managedType": "UIntPtr", "moduleManagedType": "UIntPtr" },
        { "name": "out_required_size", "type": "size_t*", "direction": "out", "managedType": "out UIntPtr", "moduleManagedType": "out UIntPtr" }
      ]
    },
    {
      "id": "trt8-builder-config-set-plugins-to-serialize-copied-paths",
      "entryPoint": "jyppx_trt8_builder_config_set_plugins_to_serialize",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "config", "type": "JYPPX_TensorRtBuilderConfig*", "direction": "in" },
        { "name": "paths", "type": "const char**", "direction": "in", "managedType": "IntPtr", "moduleManagedType": "IntPtr" },
        { "name": "path_count", "type": "int32_t", "direction": "in" },
        { "name": "out_set", "type": "JYPPX_Boolean*", "direction": "out", "managedType": "out int", "moduleManagedType": "out int" }
      ]
    },
    {
      "id": "trt8-execution-context-set-input-shape-binding-copied-values",
      "entryPoint": "jyppx_trt8_execution_context_set_input_shape_binding",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "context", "type": "JYPPX_TensorRtExecutionContext*", "direction": "in" },
        { "name": "binding_index", "type": "int32_t", "direction": "in" },
        { "name": "values", "type": "const int32_t*", "direction": "in", "managedType": "IntPtr", "moduleManagedType": "IntPtr" },
        { "name": "value_count", "type": "int32_t", "direction": "in" },
        { "name": "out_set", "type": "JYPPX_Boolean*", "direction": "out", "managedType": "out int", "moduleManagedType": "out int" }
      ]
    },
    {
      "id": "trt8-error-code-enum-max-metadata",
      "entryPoint": "jyppx_trt8_error_code_get_exclusive_upper_bound",
      "returnType": "BridgeStatusCode",
      "ownership": "caller-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "out_exclusive_upper_bound", "type": "int32_t*", "direction": "out" }
      ]
    }
  ]
}
