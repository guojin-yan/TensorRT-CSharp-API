{
  "$schema": "../../bridge-api.schema.json",
  "module": "tensorrt",
  "versionLine": "8",
  "apis": [
    {
      "id": "trt8-execution-context-execute-legacy-safe",
      "entryPoint": "jyppx_trt8_execution_context_execute_legacy_safe",
      "returnType": "BridgeStatusCode",
      "ownership": "context-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "context", "type": "JYPPX_TensorRtExecutionContext*", "direction": "in" },
        { "name": "batch_size", "type": "int32_t", "direction": "in" }
      ]
    },
    {
      "id": "trt8-execution-context-execute-v2-safe",
      "entryPoint": "jyppx_trt8_execution_context_execute_v2_safe",
      "returnType": "BridgeStatusCode",
      "ownership": "context-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8",
      "parameters": [
        { "name": "context", "type": "JYPPX_TensorRtExecutionContext*", "direction": "in" }
      ]
    },
    {
      "id": "trt8-execution-context-enqueue-v2-safe",
      "entryPoint": "jyppx_trt8_execution_context_enqueue_v2_safe",
      "returnType": "BridgeStatusCode",
      "ownership": "context-owned",
      "manualOverride": false,
      "versionGuard": "JYPPX_TENSORRT_VERSION_MAJOR_NUM == 8 && JYPPX_HAS_CUDA_TOOLKIT",
      "parameters": [
        { "name": "context", "type": "JYPPX_TensorRtExecutionContext*", "direction": "in" },
        { "name": "stream", "type": "JYPPX_CudaStream*", "direction": "in" }
      ]
    }
  ]
}
