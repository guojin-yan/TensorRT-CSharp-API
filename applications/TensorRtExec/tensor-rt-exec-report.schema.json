{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jyppx.github.io/TensorRtSharp/schemas/tensor-rt-exec-report.schema.json",
  "title": "TensorRtExec report schema",
  "description": "Schema for the current TensorRtExec/OnnxEngineBuildDiagnostics JSON output. A TensorRtExec report is build/report evidence only and is not runtime proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Success",
    "Skipped",
    "State",
    "TensorRtLine",
    "ModelSource",
    "EnginePath",
    "Parsed",
    "EngineSaved",
    "EngineFileRoundTrip",
    "DryRun",
    "InferenceRan",
    "OutputMatch",
    "ProfileIndex",
    "SkipReason",
    "NormalizedCommandLine",
    "NormalizedCommandSha256",
    "DeploymentOptions",
    "RuntimeOptions",
    "PreflightMetadata",
    "LoadedEngineDiagnostics",
    "TimingCacheArtifact",
    "CapabilityProbe",
    "WorkspaceBytes",
    "BuilderConfigDeploymentSnapshot",
    "ParserPreflightSnapshot",
    "RefitSnapshot",
    "RefitPersistenceSnapshot",
    "OptionImplementationStatus",
    "BenchmarkSummary",
    "ProofClassification",
    "EvidenceClassifications",
    "BuildEvidenceOnly",
    "IsRealModelRuntimeProof",
    "IsPackageConsumerRuntimeProof",
    "StdoutSummary",
    "StderrSummary",
    "ModelEvidence",
    "EvidenceSidecarPath",
    "EvidenceSidecarProofClassification",
    "EvidenceSidecarDiagnostics",
    "Diagnostics",
    "LogLines",
    "IsRuntimeExecutionProof",
    "ReportBoundary"
  ],
  "properties": {
    "Success": { "type": "boolean" },
    "Skipped": { "type": "boolean" },
    "State": { "type": "string" },
    "TensorRtLine": { "type": "integer" },
    "ModelSource": { "type": "string" },
    "EnginePath": { "type": "string" },
    "Parsed": { "type": "boolean" },
    "EngineSaved": { "type": "boolean" },
    "EngineFileRoundTrip": { "type": "boolean" },
    "DryRun": { "type": "boolean" },
    "InferenceRan": { "type": "boolean" },
    "OutputMatch": { "type": "boolean" },
    "ProfileIndex": { "type": "integer" },
    "ElapsedMilliseconds": { "type": [ "number", "null" ] },
    "SkipReason": { "type": "string" },
    "NormalizedCommandLine": { "type": "string" },
    "NormalizedCommandSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "DeploymentOptions": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "BuilderOptimizationLevel",
        "MaxNbTactics",
        "TilingOptimizationLevel",
        "L2LimitForTilingBytes",
        "QuantizationFlags",
        "MemoryPoolSizes",
        "CalibrationCacheFile",
        "VersionCompatible",
        "ExportTimingCachePath",
        "Safe",
        "Consistency",
        "BuilderCache",
        "NoBuilderCache",
        "RefitFromOnnxPath",
        "SaveRefittedEnginePath"
      ],
      "properties": {
        "MaxNbTactics": { "type": [ "integer", "null" ], "minimum": 0 },
        "TilingOptimizationLevel": { "type": [ "string", "null" ] },
        "L2LimitForTilingBytes": { "type": [ "integer", "null" ], "minimum": 0 },
        "QuantizationFlags": { "type": [ "string", "null" ] }
      }
    },
    "RuntimeOptions": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "NoDataTransfers",
        "UseSpinWait",
        "LoadInputs",
        "DumpOutput",
        "DumpRawBindingsToFile",
        "ExportOutputPath",
        "ExportTimesPath",
        "ExportProfilePath",
        "SaveProfilePath"
      ]
    },
    "PreflightMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Kind",
        "Path",
        "Exists",
        "LengthBytes",
        "Sha256",
        "PreflightState",
        "ProofClassification",
        "EvidenceBoundary"
      ]
    },
    "LoadedEngineDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Attempted",
        "Succeeded",
        "DiagnosticsState",
        "FailureReason",
        "EngineName",
        "IOTensorCount",
        "LayerCount",
        "OptimizationProfileCount",
        "DeviceMemorySizeInBytes",
        "AuxiliaryStreamCount",
        "Capability",
        "ProfilingVerbosity",
        "InspectorInformationLength",
        "IOTensorSummaries",
        "ReadbackFingerprint",
        "ReadbackSha256",
        "EvidenceBoundary"
      ]
    },
    "TimingCacheArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "InputRequested",
        "InputApplied",
        "InputPath",
        "InputLengthBytes",
        "InputSha256",
        "OutputRequested",
        "OutputWritten",
        "OutputPath",
        "OutputLengthBytes",
        "OutputSha256",
        "State",
        "EvidenceBoundary"
      ],
      "properties": {
        "InputRequested": { "type": "boolean" },
        "InputApplied": { "type": "boolean" },
        "InputPath": { "type": "string" },
        "InputLengthBytes": { "type": "integer", "minimum": 0 },
        "InputSha256": { "type": "string" },
        "OutputRequested": { "type": "boolean" },
        "OutputWritten": { "type": "boolean" },
        "OutputPath": { "type": "string" },
        "OutputLengthBytes": { "type": "integer", "minimum": 0 },
        "OutputSha256": { "type": "string" },
        "State": { "type": "string" },
        "EvidenceBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "CapabilityProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Attempted",
        "ProbeState",
        "TensorRtLine",
        "TensorRtVersion",
        "CudaToolkitVersion",
        "RuntimeAvailable",
        "BuilderAvailable",
        "BuilderConfigAvailable",
        "EngineInspectorApiAvailable",
        "Fp8FlagRequested",
        "Fp8FlagKnown",
        "DebugTensorOptionsRequested",
        "DebugTensorApiKnown",
        "WeightStreamingRequested",
        "WeightStreamingApiKnown",
        "ProbeItems",
        "EvidenceBoundary"
      ],
      "properties": {
        "Attempted": { "type": "boolean" },
        "ProbeState": { "type": "string" },
        "TensorRtLine": { "type": "integer" },
        "TensorRtVersion": { "type": "string" },
        "CudaToolkitVersion": { "type": "string" },
        "RuntimeAvailable": { "type": "boolean" },
        "BuilderAvailable": { "type": "boolean" },
        "BuilderConfigAvailable": { "type": "boolean" },
        "EngineInspectorApiAvailable": { "type": "boolean" },
        "Fp8FlagRequested": { "type": "boolean" },
        "Fp8FlagKnown": { "type": "boolean" },
        "DebugTensorOptionsRequested": { "type": "boolean" },
        "DebugTensorApiKnown": { "type": "boolean" },
        "WeightStreamingRequested": { "type": "boolean" },
        "WeightStreamingApiKnown": { "type": "boolean" },
        "ProbeItems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "EvidenceBoundary": {
          "type": "string"
        }
      }
    },
    "WorkspaceBytes": { "type": "integer" },
    "BuilderConfigDeploymentSnapshot": {
      "type": [ "object", "null" ],
      "description": "Copied builder-config readback after applying deployment options. This is build/deployment diagnostics only, not runtime proof.",
      "additionalProperties": true
    },
    "ParserPreflightSnapshot": {
      "type": "object",
      "description": "Copied ONNX parser diagnostics and model-support counters after parse (evidence kind: copied-parser-preflight). Build/preflight evidence only, not runtime proof.",
      "additionalProperties": false,
      "required": ["Line", "ParseAttempted", "ParseSucceeded", "DiagnosticsState", "ErrorCount", "CopiedDiagnosticCount", "DiagnosticSummary", "IdentityOperatorSupported", "ModelSupportAttempted", "ModelSupportState", "ModelSupported", "SupportedSubgraphCount", "UnsupportedSubgraphCount", "CopiedSubgraphCount", "CopiedSupportedSubgraphCount", "CopiedUnsupportedSubgraphCount", "CopiedNodeCount", "EvidenceKind", "EvidenceBoundary", "PointerFreeCopiedSnapshot", "CanPromoteRuntimeProof", "CanPromoteReleaseProof", "CanDeleteDeferredRecord"],
      "properties": {
        "Line": { "type": "integer" }, "ParseAttempted": { "type": "boolean" }, "ParseSucceeded": { "type": "boolean" },
        "DiagnosticsState": { "type": "string" }, "ErrorCount": { "type": "integer", "minimum": 0 }, "CopiedDiagnosticCount": { "type": "integer", "minimum": 0 }, "DiagnosticSummary": { "type": "string" },
        "IdentityOperatorSupported": { "type": "boolean" }, "ModelSupportAttempted": { "type": "boolean" }, "ModelSupportState": { "type": "string" }, "ModelSupported": { "type": "boolean" },
        "SupportedSubgraphCount": { "type": "integer", "minimum": 0 }, "UnsupportedSubgraphCount": { "type": "integer", "minimum": 0 }, "CopiedSubgraphCount": { "type": "integer", "minimum": 0 }, "CopiedSupportedSubgraphCount": { "type": "integer", "minimum": 0 }, "CopiedUnsupportedSubgraphCount": { "type": "integer", "minimum": 0 }, "CopiedNodeCount": { "type": "integer", "minimum": 0 },
        "EvidenceKind": { "type": "string" }, "EvidenceBoundary": { "type": "string" }, "PointerFreeCopiedSnapshot": { "type": "boolean" }, "CanPromoteRuntimeProof": { "type": "boolean" }, "CanPromoteReleaseProof": { "type": "boolean" }, "CanDeleteDeferredRecord": { "type": "boolean" }
      }
    },
    "RefitSnapshot": {
      "type": "object",
      "description": "Copied ONNX parser-refitter diagnostics and named-weight inventory captured before any execution context is created.",
      "additionalProperties": false,
      "required": ["Attempted", "Succeeded", "State", "SourcePath", "SourceLengthBytes", "SourceSha256", "EngineRefittableBefore", "EngineRefittableAfter", "ParserRefitReturned", "EngineRefitReturned", "MissingWeightsBefore", "AllWeightsBefore", "MissingWeightsAfter", "AllWeightsAfter", "ParserErrorCount", "CopiedDiagnosticCount", "DiagnosticSummary", "ContextCreationAllowed", "EvidenceBoundary"],
      "properties": {
        "Attempted": { "type": "boolean" }, "Succeeded": { "type": "boolean" }, "State": { "type": "string" }, "SourcePath": { "type": "string" },
        "SourceLengthBytes": { "type": "integer", "minimum": 0 }, "SourceSha256": { "type": "string" },
        "EngineRefittableBefore": { "type": "boolean" }, "EngineRefittableAfter": { "type": "boolean" }, "ParserRefitReturned": { "type": "boolean" }, "EngineRefitReturned": { "type": "boolean" },
        "MissingWeightsBefore": { "type": "array", "items": { "type": "string" } }, "AllWeightsBefore": { "type": "array", "items": { "type": "string" } },
        "MissingWeightsAfter": { "type": "array", "items": { "type": "string" } }, "AllWeightsAfter": { "type": "array", "items": { "type": "string" } },
        "ParserErrorCount": { "type": "integer", "minimum": 0 }, "CopiedDiagnosticCount": { "type": "integer", "minimum": 0 }, "DiagnosticSummary": { "type": "string" },
        "ContextCreationAllowed": { "type": "boolean" }, "EvidenceBoundary": { "type": "string" }
      }
    },
    "RefitPersistenceSnapshot": {
      "type": "object",
      "description": "Copied evidence that the committed refitted engine was persisted, disposed, and independently reloaded before optional runtime execution.",
      "additionalProperties": false,
      "required": ["Attempted", "Succeeded", "State", "StrippedPlanPath", "StrippedPlanLengthBytes", "StrippedPlanSha256", "PersistedPlanPath", "PersistedPlanLengthBytes", "PersistedPlanSha256", "SerializationFlagsBefore", "SerializationFlagsAfter", "RefittableWeightsIncludedInSerialization", "ArtifactDiffersFromStrippedPlan", "OriginalRefittedEngineDisposedBeforeReload", "ReloadAttempted", "ReloadSucceeded", "ReloadEngineRefittable", "ReloadIOTensorCount", "ReloadLayerCount", "ReloadOptimizationProfileCount", "ReloadContextCreationAllowed", "ReloadEngineSelectedForRuntime", "InferenceRanFromReloadedEngine", "EvidenceBoundary"],
      "properties": {
        "Attempted": { "type": "boolean" }, "Succeeded": { "type": "boolean" }, "State": { "type": "string" },
        "StrippedPlanPath": { "type": "string" }, "StrippedPlanLengthBytes": { "type": "integer", "minimum": 0 }, "StrippedPlanSha256": { "type": "string" },
        "PersistedPlanPath": { "type": "string" }, "PersistedPlanLengthBytes": { "type": "integer", "minimum": 0 }, "PersistedPlanSha256": { "type": "string" },
        "SerializationFlagsBefore": { "type": "integer", "minimum": 0 }, "SerializationFlagsAfter": { "type": "integer", "minimum": 0 }, "RefittableWeightsIncludedInSerialization": { "type": "boolean" },
        "ArtifactDiffersFromStrippedPlan": { "type": "boolean" }, "OriginalRefittedEngineDisposedBeforeReload": { "type": "boolean" },
        "ReloadAttempted": { "type": "boolean" }, "ReloadSucceeded": { "type": "boolean" }, "ReloadEngineRefittable": { "type": "boolean" },
        "ReloadIOTensorCount": { "type": "integer", "minimum": 0 }, "ReloadLayerCount": { "type": "integer", "minimum": 0 }, "ReloadOptimizationProfileCount": { "type": "integer", "minimum": 0 },
        "ReloadContextCreationAllowed": { "type": "boolean" }, "ReloadEngineSelectedForRuntime": { "type": "boolean" }, "InferenceRanFromReloadedEngine": { "type": "boolean" },
        "EvidenceBoundary": { "type": "string" }
      }
    },
    "OptionImplementationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ParsedOptions",
        "AppliedOptions",
        "ParseOnlyOptions",
        "EvidenceBoundary"
      ],
      "properties": {
        "ParsedOptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "AppliedOptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ParseOnlyOptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "EvidenceBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "BenchmarkSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "TimingSamplesMilliseconds",
        "TimingSampleCount",
        "AveragedTimingSamplesMilliseconds",
        "AveragedTimingSampleCount",
        "AvgRunsExecuted",
        "ThreadsExecuted",
        "NoDataTransfersRequested",
        "NoDataTransfersApplied",
        "UseSpinWaitRequested",
        "UseSpinWaitApplied",
        "UseCudaGraphRequested",
        "UseCudaGraphApplied",
        "UseCudaGraphFallbackReason",
        "IterationsRequested",
        "MeasurementRoundsExecuted",
        "MeasurementRoundsPerContext",
        "InferenceIterationsExecuted",
        "WarmUpMillisecondsRequested",
        "WarmUpElapsedMilliseconds",
        "WarmUpIterationsExecuted",
        "DurationSecondsRequested",
        "MeasurementElapsedMilliseconds",
        "StreamsRequested",
        "ExecutionContextsCreated",
        "ConcurrentStreamsExecuted",
        "BenchmarkBoundary"
      ],
      "properties": {
        "AveragedTimingSamplesMilliseconds": { "type": "array", "items": { "type": "number" } },
        "AveragedTimingSampleCount": { "type": "integer", "minimum": 0 },
        "IterationsRequested": { "type": "integer", "minimum": 0 },
        "MeasurementRoundsExecuted": { "type": "integer", "minimum": 0 },
        "MeasurementRoundsPerContext": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "UseSpinWaitRequested": { "type": "boolean" },
        "UseSpinWaitApplied": { "type": "boolean" },
        "UseCudaGraphRequested": { "type": "boolean" },
        "UseCudaGraphApplied": { "type": "boolean" },
        "UseCudaGraphFallbackReason": { "type": "string" },
        "InferenceIterationsExecuted": { "type": "integer", "minimum": 0 },
        "WarmUpMillisecondsRequested": { "type": "integer", "minimum": 0 },
        "WarmUpElapsedMilliseconds": { "type": "number", "minimum": 0 },
        "WarmUpIterationsExecuted": { "type": "integer", "minimum": 0 },
        "DurationSecondsRequested": { "type": "integer", "minimum": 0 },
        "MeasurementElapsedMilliseconds": { "type": "number", "minimum": 0 },
        "StreamsRequested": { "type": "integer", "minimum": 0 },
        "InfStreamsRequested": { "type": [ "integer", "null" ], "minimum": 1 },
        "ExecutionContextsCreated": { "type": "integer", "minimum": 0 },
        "ConcurrentStreamsExecuted": { "type": "integer", "minimum": 0 }
      }
    },
    "ProofClassification": {
      "type": "string",
      "enum": [
        "build-only",
        "dependency-probe-only",
        "precheck",
        "synthetic-input-runtime",
        "real-model-runtime",
        "package-consumer-runtime"
      ]
    },
    "EvidenceClassifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "BuildEvidenceOnly": { "type": "boolean" },
    "IsRealModelRuntimeProof": { "type": "boolean" },
    "IsPackageConsumerRuntimeProof": { "type": "boolean" },
    "StdoutSummary": { "type": "string" },
    "StderrSummary": { "type": "string" },
    "ModelEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ModelSource",
        "ModelSha256",
        "ModelLicense",
        "InputAssetName",
        "InputAssetSha256"
      ]
    },
    "EvidenceSidecarPath": { "type": "string" },
    "EvidenceSidecarProofClassification": { "type": "string" },
    "EvidenceSidecarDiagnostics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "Diagnostics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "LogLines": {
      "type": "array",
      "items": { "type": "string" }
    },
    "IsRuntimeExecutionProof": { "type": "boolean" },
    "ReportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "IsRuntimeProof",
        "IsBuildOnly",
        "ForbiddenSubstituteReason",
        "CopiedDiagnosticsBoundary",
        "ParserDiagnosticsEvidenceKind",
        "ParserRefitterDiagnosticsEvidenceKind",
        "CanPromoteCopiedDiagnosticsToRuntimeProof",
        "ParserDiagnosticsOwnerAction",
        "ForbiddenSubstitutes"
      ],
      "properties": {
        "IsRuntimeProof": {
          "type": "boolean",
          "const": false
        },
        "IsBuildOnly": { "type": "boolean" },
        "ForbiddenSubstituteReason": {
          "type": "string",
          "minLength": 1
        },
        "CopiedDiagnosticsBoundary": {
          "type": "string",
          "minLength": 1
        },
        "ParserDiagnosticsEvidenceKind": {
          "type": "string",
          "const": "copied-parser-diagnostics"
        },
        "ParserRefitterDiagnosticsEvidenceKind": {
          "type": "string",
          "const": "copied-parser-refitter-diagnostics"
        },
        "CanPromoteCopiedDiagnosticsToRuntimeProof": {
          "type": "boolean",
          "const": false
        },
        "ParserDiagnosticsOwnerAction": {
          "type": "string",
          "minLength": 1
        },
        "ForbiddenSubstitutes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "build-only",
              "dry-run",
              "template",
              "local feed",
              "ProjectReference",
              "direct `.nupkg`",
              "TensorRtExec report",
              "YoloVision matrix",
              "OnnxToEngine report",
              "readonly diagnostics",
              "capability-probe-only",
              "ONNX Parser diagnostic snapshot",
              "ONNX ParserRefitter diagnostic snapshot",
              "copied-parser-diagnostics",
              "copied-parser-refitter-diagnostics"
            ]
          }
        }
      }
    }
  }
}
